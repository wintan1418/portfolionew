<header class="fixed top-0 inset-x-0 z-50" data-controller="navbar">
  <div class="nav-shell">
    <nav class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 h-16 flex items-center justify-between" aria-label="Primary">
      <%= link_to "oluwintan.com", root_path, class: "text-[13px] font-bold tracking-[0.08em] uppercase text-ink", data: { action: "navbar#closeMobile" } %>

      <div class="hidden md:flex nav-group">
        <%= nav_link_pill "Home", root_path %>
        <%= nav_link_pill "About", about_path %>
        <%= nav_link_pill "Projects", projects_path %>
        <%= nav_link_pill "Services", services_path %>
        <%= nav_link_pill "Blog", blog_path %>
        <%= nav_link_pill "Contact", contact_path %>
      </div>

      <div class="flex items-center gap-2">
        <button data-action="theme#toggle" class="nav-group !gap-0 h-9 px-1 text-ink-2" aria-label="Toggle theme">
          <span class="w-7 h-7 rounded-full flex items-center justify-center text-ink-3 light:text-ink light:bg-elev">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </span>
          <span class="w-7 h-7 rounded-full flex items-center justify-center text-ink-3 dark:text-ink dark:bg-white/10">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </span>
        </button>
        <%= link_to contact_path, class: "hidden md:inline-flex btn btn-glass btn-sm", data: { controller: "magnetic", magnetic_strength_value: 0.2 } do %>
          Let's Talk <span aria-hidden="true">→</span>
        <% end %>
        <button data-action="navbar#toggleMobile" class="md:hidden w-9 h-9 rounded-full flex items-center justify-center text-ink-2 hover:text-ink" aria-label="Toggle menu">
          <svg class="w-5 h-5" data-navbar-target="hamburgerIcon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="w-5 h-5 hidden" data-navbar-target="closeIcon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </nav>
  </div>

  <div class="md:hidden hidden px-4 mt-2" data-navbar-target="mobileMenu">
    <div class="card p-2">
      <%= mobile_nav_link "Home", root_path %>
      <%= mobile_nav_link "About", about_path %>
      <%= mobile_nav_link "Projects", projects_path %>
      <%= mobile_nav_link "Services", services_path %>
      <%= mobile_nav_link "Experience", experience_path %>
      <%= mobile_nav_link "Blog", blog_path %>
      <%= mobile_nav_link "Contact", contact_path %>
    </div>
  </div>
</header>
