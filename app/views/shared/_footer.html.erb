<% profile = current_profile rescue nil %>
<% social_links = SocialLink.visible.ordered rescue [] %>
<footer class="mt-16 px-5 sm:px-6 lg:px-8 pb-8">
  <div class="max-w-6xl mx-auto border-t border-line pt-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <p class="text-[13px] font-bold tracking-[0.08em] uppercase text-ink">oluwintan.com</p>
      <p class="mt-1 text-xs text-ink-3">&copy; <%= Date.current.year %> <%= profile&.full_name || "Oluwadare Juwon" %>. Built with Ruby on Rails and Hotwire.</p>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Footer">
      <%= link_to "Projects", projects_path, class: "text-ink-2 hover:text-ink" %>
      <%= link_to "About", about_path, class: "text-ink-2 hover:text-ink" %>
      <%= link_to "Services", services_path, class: "text-ink-2 hover:text-ink" %>
      <%= link_to "Experience", experience_path, class: "text-ink-2 hover:text-ink" %>
      <%= link_to "Blog", blog_path, class: "text-ink-2 hover:text-ink" %>
      <%= link_to "Contact", contact_path, class: "text-ink-2 hover:text-ink" %>
    </nav>
    <div class="flex items-center gap-2">
      <% social_links.each do |link| %>
        <a href="<%= link.url.strip %>" target="_blank" rel="noopener" class="icon-tile !w-9 !h-9 hover:text-ink" aria-label="<%= link.platform.titleize %>"><%= link.icon_svg("w-4 h-4") %></a>
      <% end %>
    </div>
  </div>
</footer>
