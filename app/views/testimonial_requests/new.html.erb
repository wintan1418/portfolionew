<section class="relative pt-36 pb-24" data-controller="reveal">
  <div class="max-w-2xl mx-auto px-5 sm:px-6">
    <div class="text-center mb-10">
      <h1 class="display text-4xl mt-4" data-reveal="up">Share your experience.</h1>
      <p class="mt-4 text-ink-2" data-reveal="up">A few honest sentences help more than you would think. Thank you.</p>
    </div>
    <div class="card p-6 sm:p-9" data-reveal="scale">
      <% if @testimonial.submitted_at.present? %>
        <div class="text-center py-6">
          <span class="inline-flex w-14 h-14 rounded-full bg-emerald-50 items-center justify-center mb-4"><svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg></span>
          <h2 class="text-xl font-bold text-ink">Thank you</h2>
          <p class="mt-2 text-ink-2">Your testimonial has been received.</p>
        </div>
      <% else %>
        <%= form_with(model: @testimonial, url: testimonial_request_path(token: @testimonial.token), method: :patch, class: "space-y-5") do |f| %>
          <% if @testimonial.errors.any? %>
            <div class="rounded-xl border border-rose-300 bg-rose-50 text-rose-700 px-4 py-3 text-sm">
              <ul class="list-disc list-inside"><% @testimonial.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
            </div>
          <% end %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><%= f.label :author_name, "Your name", class: "label" %><%= f.text_field :author_name, required: true, class: "field" %></div>
            <div><%= f.label :author_title, "Role", class: "label" %><%= f.text_field :author_title, placeholder: "CTO, Founder, Head of Ops", class: "field" %></div>
          </div>
          <div><%= f.label :company, class: "label" %><%= f.text_field :company, class: "field" %></div>
          <div><%= f.label :content, "Your words", class: "label" %><%= f.text_area :content, required: true, rows: 5, class: "field resize-y" %></div>
          <div>
            <%= f.label :rating, class: "label" %>
            <%= f.select :rating, options_for_select([["Pick a rating", ""], ["5, excellent", 5], ["4, very good", 4], ["3, good", 3], ["2, fair", 2], ["1, poor", 1]], @testimonial.rating), {}, class: "field" %>
          </div>
          <%= f.submit "Submit testimonial", class: "btn btn-primary w-full" %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
