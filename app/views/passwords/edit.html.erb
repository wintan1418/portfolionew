<section class="min-h-screen flex items-center justify-center px-5 py-24">
  <div class="w-full max-w-md">
    <div class="card p-8">
      <h1 class="display text-2xl mb-6">Update your password</h1>
      <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
        <div><label class="label">New password</label><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %></div>
        <div><label class="label">Repeat password</label><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %></div>
        <%= form.submit "Save", class: "btn btn-primary w-full" %>
      <% end %>
    </div>
  </div>
</section>
