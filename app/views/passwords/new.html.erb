<section class="min-h-screen flex items-center justify-center px-5 py-24">
  <div class="w-full max-w-md">
    <div class="card p-8">
      <h1 class="display text-2xl mb-2">Forgot your password?</h1>
      <p class="text-sm text-ink-2 mb-6">We will email you a reset link.</p>
      <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
        <div><label class="label">Email</label><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %></div>
        <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>
      <% end %>
    </div>
  </div>
</section>
