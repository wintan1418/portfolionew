<% content_for(:page_title) { "Dashboard" } %>

<div class="flex items-end justify-between gap-6 mb-6">
  <div>
    <p class="eyebrow">Overview</p>
    <h2 class="text-2xl font-semibold tracking-tight text-ink mt-1">Welcome back, <%= @profile.first_name %>.</h2>
  </div>
  <%= link_to "New project", new_admin_project_path, class: "btn btn-primary btn-sm" %>
</div>

<div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
  <% [["Total views", number_with_delimiter(@total_views), "All time"], ["Today", number_with_delimiter(@views_today), Date.current.strftime("%b %d")], ["This week", number_with_delimiter(@views_this_week), "Last 7 days"], ["This month", number_with_delimiter(@views_this_month), "Last 30 days"], ["Subscribers", number_with_delimiter(@subscriber_count), "Active"]].each do |label, value, sub| %>
    <div class="card p-5"><p class="text-xs text-ink-3"><%= label %></p><p class="display text-3xl text-ink mt-1"><%= value %></p><p class="text-xs text-ink-3 mt-1"><%= sub %></p></div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
  <div class="lg:col-span-7 card p-6">
    <div class="flex items-center justify-between mb-4"><h3 class="font-semibold text-ink">Popular pages</h3><span class="text-xs text-ink-3">Last 30 days</span></div>
    <% if @popular_pages.any? %>
      <% max = @popular_pages.values.max.to_f %>
      <ul class="space-y-2.5">
        <% @popular_pages.each do |path, count| %>
          <li>
            <div class="flex items-center justify-between text-sm"><span class="text-ink-2 truncate font-mono text-xs"><%= path %></span><span class="text-ink"><%= number_with_delimiter(count) %></span></div>
            <div class="mt-1 h-1 rounded-full bg-white/5 overflow-hidden"><div class="h-full rounded-full bg-ink/60" style="width: <%= (count / max * 100).round %>%"></div></div>
          </li>
        <% end %>
      </ul>
    <% else %><p class="text-sm text-ink-3">No page views recorded yet.</p><% end %>
  </div>

  <div class="lg:col-span-5 space-y-4">
    <div class="card p-6">
      <h3 class="font-semibold text-ink mb-3">Content</h3>
      <dl class="grid grid-cols-3 gap-3 text-center">
        <%= link_to admin_projects_path, class: "rounded-xl border border-line p-3 hover:bg-white/5" do %><dd class="display text-2xl text-ink"><%= @projects_count %></dd><dt class="text-xs text-ink-3">Projects</dt><% end %>
        <%= link_to admin_posts_path, class: "rounded-xl border border-line p-3 hover:bg-white/5" do %><dd class="display text-2xl text-ink"><%= @posts_count %></dd><dt class="text-xs text-ink-3">Posts</dt><% end %>
        <%= link_to admin_contacts_path, class: "rounded-xl border border-line p-3 hover:bg-white/5" do %><dd class="display text-2xl text-ink"><%= @contacts_count %></dd><dt class="text-xs text-ink-3">Contacts</dt><% end %>
      </dl>
      <p class="mt-4 text-xs text-ink-3"><%= @profile.full_name %> · <%= @profile.headline %> · <%= link_to "edit profile", edit_admin_profile_path, class: "text-ink-2 hover:text-ink underline underline-offset-2" %></p>
    </div>

    <div class="card p-6">
      <div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-ink">Recent messages</h3><%= link_to "All", admin_contacts_path, class: "text-xs text-ink-2 hover:text-ink" %></div>
      <% if @recent_contacts.any? %>
        <ul class="divide-y divide-line">
          <% @recent_contacts.each do |c| %>
            <li class="py-2.5"><%= link_to admin_contact_path(c), class: "block group" do %>
              <div class="flex items-center justify-between gap-3"><span class="text-sm text-ink truncate"><%= c.name %></span><span class="text-xs text-ink-3 shrink-0"><%= time_ago_in_words(c.created_at) %> ago</span></div>
              <p class="text-xs text-ink-2 truncate"><%= c.subject.presence || c.message.truncate(70) %></p>
            <% end %></li>
          <% end %>
        </ul>
      <% else %><p class="text-sm text-ink-3">No messages yet.</p><% end %>
    </div>
  </div>
</div>
