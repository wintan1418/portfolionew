<!DOCTYPE html>
<html lang="en" class="dark" data-controller="theme">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#07090d">
    <meta name="view-transition" content="same-origin">

    <%= display_meta_tags(site: "Oluwadare Juwon", separator: "|", reverse: true) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <script>
      // Apply the saved theme before first paint to avoid a flash.
      try { var t = localStorage.getItem("theme"); if (t === "light") { document.documentElement.classList.replace("dark", "light"); } } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/rss+xml" title="Blog feed" href="<%= blog_feed_url %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "gsap.min", "ScrollTrigger.min", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-ink min-h-screen antialiased font-sans overflow-x-hidden"
        data-controller="glass turbo-transitions">

    <!-- Ambient backdrop -->

    <div class="backdrop" aria-hidden="true"><span></span><span></span><span></span></div>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] btn btn-primary btn-sm">Skip to content</a>

    <%= render "shared/navbar" %>

    <!-- Flash -->
    <% if notice.present? || alert.present? %>
      <div class="fixed top-24 inset-x-4 sm:inset-x-auto sm:right-6 z-[65] animate-slide-down" data-controller="toast" data-toast-delay-value="5000">
        <div class="card px-5 py-3.5 text-sm flex items-center gap-3 max-w-md sm:ml-auto <%= notice.present? ? 'text-emerald-600' : 'text-rose-600' %>">
          <% if notice.present? %>
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
            <span class="text-ink"><%= notice %></span>
          <% else %>
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-ink"><%= alert %></span>
          <% end %>
          <button data-action="toast#dismiss" class="ml-auto text-ink-3 hover:text-ink transition-colors" aria-label="Dismiss">&times;</button>
        </div>
      </div>
    <% end %>

    <main id="main-content" class="relative z-10">
      <%= yield %>
    </main>

    <div class="relative z-10">
      <%= render "shared/footer" %>
    </div>

    <%= render "shared/command_palette" %>
  </body>
</html>
