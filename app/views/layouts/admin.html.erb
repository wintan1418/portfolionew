<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= [yield(:page_title).presence, "Admin"].compact.join(" · ") %> | oluwintan.com</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "gsap.min", "ScrollTrigger.min", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-shell bg-canvas text-ink min-h-screen antialiased font-sans">
    <div class="backdrop" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="relative z-10 flex min-h-screen">
      <%= render "admin/shared/sidebar" %>

      <div class="flex-1 lg:ml-64 min-w-0">
        <header class="sticky top-0 z-30 admin-topbar px-5 sm:px-8 h-16 flex items-center justify-between">
          <h1 class="text-base font-semibold tracking-tight text-ink"><%= yield :page_title %></h1>
          <div class="flex items-center gap-2">
            <%= link_to root_path, class: "btn btn-glass btn-sm", target: "_blank" do %>View site ↗<% end %>
            <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          </div>
        </header>

        <% if notice.present? || alert.present? %>
          <div class="mx-5 sm:mx-8 mt-5 card px-4 py-3 text-sm flex items-center gap-3 <%= notice.present? ? 'text-emerald-300' : 'text-rose-300' %>" data-controller="toast" data-toast-delay-value="6000">
            <span class="live-dot" style="<%= 'background:#f43f5e' if alert.present? %>"></span>
            <span class="text-ink"><%= notice.presence || alert %></span>
          </div>
        <% end %>

        <main class="p-5 sm:p-8 admin-content">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
