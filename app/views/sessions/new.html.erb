<section class="min-h-screen flex items-center justify-center px-5 py-24">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
            <h1 class="display text-3xl">Welcome back</h1>
      <p class="text-ink-2 text-sm mt-2">Sign in to the admin</p>
    </div>
    <div class="card p-8">
      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <div><label class="label">Email</label><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %></div>
        <div><label class="label">Password</label><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %></div>
        <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
        <div class="text-center"><%= link_to "Forgot password?", new_password_path, class: "text-xs text-ink-3 hover:text-ink transition-colors" %></div>
      <% end %>
    </div>
  </div>
</section>
