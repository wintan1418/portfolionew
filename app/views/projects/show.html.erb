<% p = @project %>
<% content_for :head do %>
  <%= json_ld_tag({ "@context": "https://schema.org", "@type": "CreativeWork", "name": p.title, "description": p.tagline.presence || p.summary, "url": project_url(p), "author": { "@type": "Person", "name": current_profile.full_name } }) %>
<% end %>

<article data-controller="lightbox">
  <section class="pt-28 pb-6 sm:pt-36" data-controller="reveal">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
      <%= link_to projects_path, class: "inline-flex items-center gap-2 text-sm text-ink-2 hover:text-ink", data: { reveal: "fade" } do %><span aria-hidden="true">←</span> Back to projects<% end %>
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5">
          <p class="text-xs text-ink-3" data-reveal="fade"><%= [p.category.presence || p.type_label, p.year, p.role].compact_blank.join(" · ") %></p>
          <h1 class="display-serif text-5xl sm:text-6xl mt-3" data-reveal="up"><%= p.title %></h1>
          <% if p.tagline.present? %><p class="mt-5 text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05"><%= p.tagline %></p><% end %>
          <% if p.tech_stack.any? %>
            <div class="mt-6 flex flex-wrap gap-1.5" data-reveal="fade" data-reveal-delay="0.1"><% p.tech_stack.first(5).each do |t| %><span class="chip"><%= t %></span><% end %></div>
          <% end %>
          <div class="mt-8 flex flex-wrap gap-3" data-reveal="fade" data-reveal-delay="0.15">
            <% if p.live? %><a href="<%= p.live_url %>" target="_blank" rel="noopener" class="btn btn-primary" data-controller="magnetic">View Live Project <span aria-hidden="true">→</span></a><% end %>
            <% if p.github_url.present? %><a href="<%= p.github_url %>" target="_blank" rel="noopener" class="btn btn-glass">Source code</a><% end %>
          </div>
        </div>
        <div class="lg:col-span-7" data-reveal="right">
          <div class="tilt-3d">
            <div class="shot aspect-[16/10] cursor-zoom-in" data-lightbox-src="<%= url_for(p.cover_image) if p.cover_image.attached? %>" data-lightbox-caption="<%= p.title %>" data-action="click->lightbox#open">
              <% if p.cover_image.attached? %><%= image_tag p.cover_image, alt: p.title, loading: "eager" %><% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16" data-controller="reveal">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-7 space-y-12">
        <% if p.summary.present? || p.body.present? %>
          <div data-reveal="up">
            <h2 class="section-title">Overview</h2>
            <% if p.summary.present? %><p class="mt-3 text-[15px] text-ink-2 leading-relaxed"><%= p.summary %></p><% end %>
            <% if p.body.present? %><div class="prose-glass mt-4 !text-[15px]"><%= p.body %></div><% end %>
          </div>
        <% end %>
        <% if p.highlights.any? %>
          <div data-reveal="up">
            <h2 class="section-title">Key Features</h2>
            <ul class="check-list mt-4 space-y-2.5 text-[15px] text-ink-2 leading-relaxed"><% p.highlights.each do |h| %><li><span><%= h %></span></li><% end %></ul>
          </div>
        <% end %>
        <% { "The Challenge" => p.challenge, "The Approach" => p.solution, "The Outcome" => p.results }.each do |title, text| %>
          <% next if text.blank? %>
          <div data-reveal="up"><h2 class="section-title"><%= title %></h2><div class="mt-3 text-[15px] text-ink-2 leading-relaxed space-y-3"><%= simple_format(text, {}, wrapper_tag: "p") %></div></div>
        <% end %>
      </div>

      <aside class="lg:col-span-5 space-y-5 lg:sticky lg:top-24 self-start">
        <% if p.tech_stack.any? %>
          <div class="card p-6" data-reveal="right">
            <h2 class="font-semibold text-ink">Tech Stack</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              <% p.tech_stack.each do |t| %><span class="tech-chip"><%= tech_icon(t.sub(/\s*\d+(\.\d+)?\z/, ""), css: "w-4 h-4") %><%= t %></span><% end %>
            </div>
          </div>
        <% end %>
        <div class="card p-6" data-reveal="right" data-reveal-delay="0.05">
          <dl class="text-sm divide-y divide-line">
            <% [["Type", p.type_label], ["Role", p.role], ["Year", p.year], ["Client", p.client_name], ["Status", p.status&.titleize]].reject { |_, v| v.blank? }.each do |label, value| %>
              <div class="py-3 flex justify-between gap-4"><dt class="text-ink-3"><%= label %></dt><dd class="text-ink text-right"><%= value %></dd></div>
            <% end %>
          </dl>
          <% if p.metrics_list.any? %>
            <dl class="mt-4 grid grid-cols-2 gap-3"><% p.metrics_list.each do |label, value| %><div class="rounded-xl border border-line p-3"><dd class="display text-xl text-ink"><%= value %></dd><dt class="text-xs text-ink-3 mt-0.5"><%= label %></dt></div><% end %></dl>
          <% end %>
        </div>
        <% if @siblings.any? %>
          <div class="card p-6" data-reveal="right" data-reveal-delay="0.1">
            <h2 class="font-semibold text-ink">Same family</h2>
            <ul class="mt-3 space-y-2 text-sm"><% @siblings.each do |s| %><li><%= link_to "#{s.title} →", project_path(s), class: "text-ink-2 hover:text-ink" %></li><% end %></ul>
          </div>
        <% end %>
      </aside>
    </div>
  </section>

  <% desktop = p.desktop_images; mobile = p.mobile_images %>
  <% if desktop.any? || mobile.any? %>
    <section class="py-10" data-controller="reveal">
      <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
        <h2 class="section-title mb-6" data-reveal="fade">Screens</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-reveal="stagger">
          <% desktop.each do |img| %><div class="card p-2.5"><%= render "components/browser_frame", image: img, alt: "#{p.title} screen", lightbox: true %></div><% end %>
        </div>
        <% if mobile.any? %>
          <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-5" data-reveal="stagger">
            <% mobile.each do |img| %><div class="card p-2"><%= render "components/phone_frame", image: img, alt: "#{p.title} mobile", lightbox: true %></div><% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="py-10">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 flex justify-between gap-4 text-sm">
      <% if @prev_project && @prev_project != p %><%= link_to "← #{@prev_project.title}", project_path(@prev_project), class: "btn btn-glass btn-sm" %><% else %><span></span><% end %>
      <% if @next_project && @next_project != p %><%= link_to "#{@next_project.title} →", project_path(@next_project), class: "btn btn-glass btn-sm" %><% end %>
    </div>
  </section>

  <dialog data-lightbox-target="dialog" data-action="click->lightbox#closeOnBackdrop" class="fixed inset-0 z-[100] m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm">
    <div class="w-full h-full flex items-center justify-center p-4 sm:p-10">
      <figure class="relative max-w-6xl w-full">
        <img data-lightbox-target="image" src="" alt="" class="w-full max-h-[82vh] object-contain rounded-lg">
        <figcaption class="mt-3 flex items-center justify-between text-xs text-white/70"><span data-lightbox-target="caption"></span><span data-lightbox-target="counter"></span></figcaption>
        <button data-action="lightbox#prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white" aria-label="Previous">←</button>
        <button data-action="lightbox#next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white" aria-label="Next">→</button>
        <button data-action="lightbox#close" class="absolute -top-12 right-0 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white" aria-label="Close">×</button>
      </figure>
    </div>
  </dialog>
</article>
