<section class="pt-32 pb-8 sm:pt-40" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <h1 class="display-serif text-5xl sm:text-6xl" data-reveal="up">Featured Work</h1>
    <p class="mt-5 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">A selection of products, experiments and client work I've built. Each project is a real solution to a real problem.</p>
    <div class="mt-7 flex flex-wrap items-center gap-2" data-reveal="fade" data-reveal-delay="0.1">
      <%= link_to "All", projects_path, data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:type].blank? && params[:tech].blank?}" %>
      <% @types.each do |type| %>
        <%= link_to Project::TYPES[type] || type.titleize, projects_path(type: type), data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:type] == type}" %>
      <% end %>
      <% @all_tech.first(4).each do |tech| %>
        <%= link_to tech, projects_path(tech: tech), data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:tech] == tech}" %>
      <% end %>
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <%= turbo_frame_tag "projects" do %>
      <% if @projects.any? %>
        <% lead, *rest = @projects.to_a %>
        <div data-controller="reveal">
          <%= link_to project_path(lead), class: "card card-lift p-5 sm:p-6 group block", data: { reveal: "up" } do %>
            <div class="tablet mx-auto max-w-3xl lg:max-w-4xl px-4 sm:px-10 pt-2">
              <div class="mount"><div class="shot aspect-[16/9]">
                <% if lead.cover_image.attached? %><%= image_tag lead.cover_image, alt: lead.title, loading: "eager" %><% end %>
              </div></div>
            </div>
            <div class="mt-8 sm:mt-10 flex items-start justify-between gap-6">
              <div class="min-w-0">
                <p class="text-xs text-ink-3"><%= lead.category.presence || lead.type_label %></p>
                <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink"><%= lead.title %></h2>
                <p class="mt-2 max-w-2xl text-[15px] text-ink-2 leading-relaxed"><%= lead.tagline.presence || lead.summary %></p>
                <% if lead.tech_stack.any? %><div class="mt-4 flex flex-wrap gap-1.5"><% lead.tech_stack.first(4).each do |t| %><span class="chip"><%= t %></span><% end %></div><% end %>
              </div>
              <span class="arrow-btn shrink-0 mt-2" aria-hidden="true">→</span>
            </div>
            <span class="glow-blob -left-24 -bottom-28 opacity-60"></span>
          <% end %>

          <div class="mt-4 space-y-3">
            <% rest.each_with_index do |project, i| %>
              <%= link_to project_path(project), class: "card card-lift p-4 sm:p-5 flex items-center gap-5 sm:gap-7 group", data: { reveal: "up", reveal_delay: [i * 0.03, 0.2].min } do %>
                <div class="shot w-32 sm:w-44 aspect-[16/10] shrink-0 !shadow-none">
                  <% if project.cover_image.attached? %><%= image_tag project.cover_image, alt: project.title, loading: "lazy" %><% else %><div class="w-full h-full grid place-items-center text-ink-3 font-semibold"><%= project.title.first(2).upcase %></div><% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-ink-3"><%= project.category.presence || project.type_label %><% if project.year %> · <%= project.year %><% end %></p>
                  <h3 class="mt-0.5 font-semibold tracking-tight text-ink"><%= project.title %></h3>
                  <p class="mt-1 text-sm text-ink-2 leading-relaxed line-clamp-2"><%= project.tagline.presence || project.summary %></p>
                  <% if project.tech_stack.any? %><div class="mt-2.5 hidden sm:flex flex-wrap gap-1.5"><% project.tech_stack.first(3).each do |t| %><span class="chip !text-[11px] !py-0.5"><%= t %></span><% end %></div><% end %>
                </div>
                <span class="arrow-btn shrink-0 !w-10 !h-10" aria-hidden="true">→</span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="card p-12 text-center text-ink-2">Nothing here yet. <%= link_to "Show everything", projects_path, class: "underline underline-offset-4", data: { turbo_frame: "projects" } %></div>
      <% end %>
    <% end %>
  </div>
</section>
