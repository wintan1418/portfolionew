<section class="pt-32 pb-10 sm:pt-40" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <h1 class="display-serif text-5xl sm:text-6xl" data-reveal="up">Featured Work</h1>
    <p class="mt-5 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">A selection of products, experiments and client work I've built. Each project is a real solution to a real problem.</p>
    <div class="mt-7 flex flex-wrap items-center gap-2" data-reveal="fade" data-reveal-delay="0.1">
      <%= link_to "All", projects_path, data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:type].blank? && params[:tech].blank?}" %>
      <% @types.each do |type| %>
        <%= link_to Project::TYPES[type] || type.titleize, projects_path(type: type), data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:type] == type}" %>
      <% end %>
      <% @all_tech.first(4).each do |tech| %>
        <%= link_to tech, projects_path(tech: tech), data: { turbo_frame: "projects", turbo_action: "advance" }, class: "chip #{'chip-active' if params[:tech] == tech}" %>
      <% end %>
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <%= turbo_frame_tag "projects" do %>
      <% if @projects.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-controller="reveal">
          <% @projects.each_with_index do |project, i| %>
            <%= link_to project_path(project), class: "card card-lift p-5 group block", data: { reveal: "up", reveal_delay: (i % 2) * 0.06 } do %>
              <div class="shot aspect-[16/9]">
                <% if project.cover_image.attached? %><%= image_tag project.cover_image, alt: project.title, loading: "lazy" %><% else %><div class="w-full h-full grid place-items-center text-ink-3 text-3xl font-semibold"><%= project.title.first(2).upcase %></div><% end %>
              </div>
              <div class="mt-5 flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs text-ink-3"><%= project.category.presence || project.type_label %></p>
                  <h3 class="mt-1 text-lg font-semibold tracking-tight text-ink"><%= project.title %></h3>
                  <p class="mt-1.5 text-sm text-ink-2 leading-relaxed line-clamp-2"><%= project.tagline.presence || project.summary %></p>
                </div>
                <span class="icon-tile !rounded-full shrink-0 group-hover:bg-ink group-hover:text-canvas transition-colors" aria-hidden="true">→</span>
              </div>
              <% if project.tech_stack.any? %>
                <div class="mt-4 flex flex-wrap gap-1.5"><% project.tech_stack.first(4).each do |t| %><span class="chip"><%= t %></span><% end %></div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card p-12 text-center text-ink-2">Nothing here yet. <%= link_to "Show everything", projects_path, class: "underline underline-offset-4", data: { turbo_frame: "projects" } %></div>
      <% end %>
    <% end %>
  </div>
</section>
