<section class="pt-32 pb-10 sm:pt-40" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <h1 class="display-serif text-5xl sm:text-6xl" data-reveal="up">Insights & Ideas</h1>
    <p class="mt-5 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">Thoughts, tutorials and lessons from building real products.</p>
    <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-3" data-reveal="fade" data-reveal-delay="0.1" data-controller="search">
      <%= form_with url: blog_path, method: :get, data: { turbo_frame: "posts", turbo_action: "advance", search_target: "form" }, class: "w-full sm:max-w-sm" do |f| %>
        <% if params[:category].present? %><%= hidden_field_tag :category, params[:category] %><% end %>
        <div class="relative">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search articles..." autocomplete="off" class="field !rounded-full !pl-10 !py-2.5" data-search-target="input" data-action="input->search#submit">
        </div>
      <% end %>
      <% if @categories.any? %>
        <div class="flex flex-wrap gap-2">
          <%= link_to "All", blog_path(search: params[:search].presence), data: { turbo_frame: "posts", turbo_action: "advance" }, class: "chip #{'chip-active' unless @category}" %>
          <% @categories.each do |cat| %>
            <%= link_to cat.name, blog_path(category: cat.slug, search: params[:search].presence), data: { turbo_frame: "posts", turbo_action: "advance" }, class: "chip #{'chip-active' if @category&.id == cat.id}" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <%= turbo_frame_tag "posts", target: "_top" do %>
      <% if @posts.any? %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3" data-controller="reveal">
          <% @posts.each_with_index do |post, i| %>
            <%= link_to blog_post_path(post.slug), data: { turbo_frame: "_top", reveal: "up", reveal_delay: (i % 2) * 0.05 }, class: "card card-lift p-3 flex items-center gap-4 group" do %>
              <div class="shot w-28 sm:w-36 aspect-[4/3] shrink-0 !shadow-none">
                <% if post.cover_image.attached? %><%= image_tag post.cover_image, loading: "lazy" %><% else %><div class="w-full h-full grid place-items-center text-ink-3 font-semibold"><%= post.title.first(2).upcase %></div><% end %>
              </div>
              <div class="flex-1 min-w-0 py-1">
                <h3 class="font-semibold tracking-tight text-ink leading-snug line-clamp-2"><%= post.title %></h3>
                <p class="mt-1.5 text-xs text-ink-3"><%= post.category&.name %><% if post.category && post.reading_time %> · <% end %><% if post.reading_time %><%= post.reading_time %> min read<% end %></p>
              </div>
              <span class="text-ink-3 group-hover:text-ink pr-2" aria-hidden="true">›</span>
            <% end %>
          <% end %>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="mt-10 flex justify-center text-sm [&_nav]:flex [&_nav]:gap-1 [&_a]:chip [&_.current]:chip-active"><%== pagy_nav(@pagy) %></div>
        <% end %>
      <% else %>
        <div class="card p-12 text-center text-ink-2">Nothing matches that yet.</div>
      <% end %>
    <% end %>
  </div>
</section>
