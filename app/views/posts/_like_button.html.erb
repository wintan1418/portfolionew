<div id="like-button-<%= post.id %>" data-controller="like">
  <%= button_to blog_post_like_path(post.slug), method: :post, data: { action: "like#toggle", turbo_stream: true }, class: "btn btn-sm #{liked ? 'btn-primary' : 'btn-glass'}" do %>
    <span data-like-target="icon" class="transition-transform duration-200">
      <svg class="w-4 h-4" fill="<%= liked ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
    </span>
    <span data-like-target="count"><%= post.likes_count %></span>
    <span><%= liked ? "Liked" : "Like" %></span>
  <% end %>
</div>
