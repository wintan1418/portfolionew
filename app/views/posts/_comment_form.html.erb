<%= form_with model: comment, url: blog_post_comments_path(post.slug), data: { turbo_stream: true }, class: "space-y-4" do |f| %>
  <%= f.hidden_field :parent_id, data: { "comment-reply-target": "parentId" } %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Name *</label>
      <%= f.text_field :author_name, required: true, placeholder: "Your name", class: "field" %>
      <% if comment.errors[:author_name].any? %><p class="mt-1 text-xs text-rose-400"><%= comment.errors[:author_name].first %></p><% end %>
    </div>
    <div>
      <label class="label">Email <span class="normal-case tracking-normal">(optional, never shown)</span></label>
      <%= f.email_field :author_email, placeholder: "you@email.com", class: "field" %>
      <% if comment.errors[:author_email].any? %><p class="mt-1 text-xs text-rose-400"><%= comment.errors[:author_email].first %></p><% end %>
    </div>
  </div>
  <div>
    <label class="label">Comment *</label>
    <%= f.text_area :body, required: true, rows: 4, placeholder: "Share your thoughts", class: "field resize-y" %>
    <% if comment.errors[:body].any? %><p class="mt-1 text-xs text-rose-400"><%= comment.errors[:body].first %></p><% end %>
  </div>
  <div class="flex items-center gap-3">
    <%= f.submit "Post comment", class: "btn btn-primary btn-sm" %>
    <button type="button" data-action="comment-reply#cancelReply" data-cancel-reply class="hidden btn btn-ghost btn-sm">Cancel reply</button>
  </div>
<% end %>
