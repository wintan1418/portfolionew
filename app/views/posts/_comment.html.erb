<div id="comment-<%= comment.id %>" class="<%= 'ml-8 sm:ml-12' if comment.parent_id.present? %>">
  <div class="flex gap-3">
    <div class="shrink-0 w-9 h-9 rounded-full bg-elev border border-line grid place-items-center text-ink-2 text-xs font-semibold uppercase"><%= comment.author_name.first(2) %></div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm font-semibold text-ink"><%= comment.author_name %></span>
        <span class="text-xs text-ink-3"><%= time_ago_in_words(comment.created_at) %> ago</span>
      </div>
      <div class="mt-1.5 text-sm text-ink-2 leading-relaxed"><%= simple_format(h(comment.body), {}, wrapper_tag: "p") %></div>
      <button type="button" data-action="comment-reply#reply" data-comment-id="<%= comment.id %>" data-author-name="<%= comment.author_name %>" class="mt-2 text-xs text-ink-3 hover:text-ink">Reply</button>
    </div>
  </div>
  <% if comment.replies.any? %>
    <div class="mt-4 space-y-4 border-l border-line pl-4">
      <% comment.replies.oldest_first.each do |reply| %><%= render "posts/comment", comment: reply %><% end %>
    </div>
  <% end %>
</div>
