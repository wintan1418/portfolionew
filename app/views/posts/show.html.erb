<% content_for :head do %>
  <%= json_ld_tag({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": @post.title,
    "description": @post.excerpt,
    "datePublished": @post.published_at&.iso8601,
    "author": { "@type": "Person", "name": current_profile&.full_name || "Wintan" },
    "url": blog_post_url(@post.slug)
  }) %>
<% end %>

<article>
  <section class="pt-32 pb-10 sm:pt-40" data-controller="reveal">
    <div class="max-w-3xl mx-auto px-5 sm:px-6">
      <p class="eyebrow" data-reveal="fade"><%= link_to "Writing", blog_path, class: "hover:text-ink" %><% if @post.category %> / <%= @post.category.name %><% end %> · <%= @post.published_at&.strftime("%B %d, %Y") %><% if @post.reading_time %> · <%= @post.reading_time %> min read<% end %></p>
      <h1 class="display-serif text-4xl sm:text-6xl mt-5" data-reveal="up"><%= @post.title %></h1>
      <% if @post.excerpt.present? %>
        <p class="mt-5 text-lg text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05"><%= @post.excerpt %></p>
      <% end %>
    </div>
  </section>

  <% if @post.cover_image.attached? %>
    <section class="pb-12" data-controller="reveal">
      <div class="max-w-5xl mx-auto px-5 sm:px-6">
        <div class="card p-3" data-reveal="scale"><div class="shot aspect-[16/8]"><%= image_tag @post.cover_image, loading: "eager" %></div></div>
      </div>
    </section>
  <% end %>

  <section class="relative pb-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="card p-6 sm:p-10"><div class="blog-content" data-controller="highlight">
        <% if @post.content_markdown.present? %>
          <%= render_markdown(@post.content_markdown) %>
        <% else %>
          <%= @post.body %>
        <% end %>
      </div>

      </div>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 px-2">
        <div class="text-sm text-ink-3">
          <% if @post.category %>Filed under <%= link_to @post.category.name, blog_category_path(@post.category.slug), class: "text-ink hover:underline underline-offset-4" %><% end %>
        </div>
        <%= render "posts/like_button", post: @post, liked: @liked %>
      </div>

      <%= render "posts/comments_section", post: @post, comments: @comments, comment: @comment, liked: @liked %>
    </div>
  </section>

  <% if @related_posts&.any? %>
    <section class="py-10" data-controller="reveal">
      <div class="max-w-5xl mx-auto px-5 sm:px-6">
        <h2 class="eyebrow mb-6" data-reveal="fade">Keep reading</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal="stagger">
          <% @related_posts.each do |post| %><%= render "components/blog_card", post: post %><% end %>
        </div>
      </div>
    </section>
  <% end %>
</article>
