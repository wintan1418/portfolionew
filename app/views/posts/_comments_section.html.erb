<div class="mt-16" data-controller="comment-reply">
  <h2 class="eyebrow mb-6 px-2">
    Comments <span id="comments-count"><% if post.comments_count > 0 %>(<%= post.comments_count %>)<% end %></span>
  </h2>

  <div id="comment-form" class="card p-6 mb-10" data-comment-reply-target="form">
    <h3 class="font-semibold text-ink mb-4">Leave a comment</h3>
    <%= render "posts/comment_form", post: post, comment: comment %>
  </div>

  <div id="comments-list">
    <% if comments.any? %>
      <div class="space-y-6">
        <% comments.each do |c| %><%= render "posts/comment", comment: c %><% end %>
      </div>
    <% else %>
      <div id="no-comments" class="text-center py-10 text-sm text-ink-3">No comments yet. Be the first.</div>
    <% end %>
  </div>
</div>
