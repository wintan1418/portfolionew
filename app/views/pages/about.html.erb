<% content_for(:title) { "About" } %>

<section class="pt-32 pb-16 sm:pt-40" data-controller="reveal parallax">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

    <div class="lg:col-span-7">
      <p class="eyebrow" data-reveal="fade">About me</p>
      <h1 class="display-serif text-5xl sm:text-6xl mt-3" data-reveal="up">Turning ideas into impactful products.</h1>
      <p class="mt-6 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">
        I'm a Full-Stack Engineer with a passion for building products that solve real problems. I specialise in Ruby on Rails, Hotwire and PostgreSQL, with React and native shells where a product needs them.
      </p>
      <dl class="mt-8 grid grid-cols-3 gap-3 max-w-xl" data-reveal="stagger" data-reveal-delay="0.1">
        <% [[@stats[:years], "+", "Years Experience"], [@stats[:projects], "+", "Projects Delivered"], [Project.where(project_type: "client").count, "+", "Happy Clients"]].each do |v, suf, label| %>
          <div class="card px-4 py-4"><dd class="display text-2xl text-ink"><%= v %><%= suf %></dd><dt class="mt-1 text-[11px] text-ink-2"><%= label %></dt></div>
        <% end %>
      </dl>

      <div class="mt-14" data-reveal="up">
        <h2 class="section-title">My Philosophy</h2>
        <p class="mt-4 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed">
          Great software is not just about code, but about people, problems and progress. I believe in clean code, thoughtful design and building with long-term impact in mind.
        </p>
      </div>
      <div class="mt-6 grid grid-cols-3 gap-3 max-w-xl" data-reveal="stagger" data-reveal-delay="0.05">
        <% [["Clean Code", "Maintainable and readable", "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"], ["Real Impact", "Products that solve real problems", "M13 10V3L4 14h7v7l9-11h-7z"], ["Continuous Learning", "New technologies, every year", "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"]].each do |label, sub, icon| %>
          <div class="card p-4 sm:p-5">
            <span class="icon-tile"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg></span>
            <p class="mt-3 text-sm font-medium text-ink"><%= label %></p>
            <p class="mt-1 text-xs text-ink-2"><%= sub %></p>
          </div>
        <% end %>
      </div>
      <blockquote class="mt-10 max-w-xl pl-5 border-l-2 border-ink" data-reveal="up">
        <p class="text-lg italic text-ink">"I enjoy turning complex problems into simple, beautiful and scalable solutions."</p>
        <cite class="mt-2 block text-sm not-italic text-ink-3">— <%= @profile.full_name %></cite>
      </blockquote>
    </div>

    <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
      <div class="portrait-panel aspect-[4/5] max-w-[340px] mx-auto lg:ml-auto" data-controller="card-tilt" data-card-tilt-max-tilt-value="4" data-card-tilt-scale-value="1.01" data-reveal="scale">
        <span class="glow" aria-hidden="true"></span>
        <% if Rails.root.join("public/images/juwon-cutout.png").exist? %><img src="/images/juwon-cutout.png" alt="<%= @profile.full_name %>" class="cutout"><% elsif @profile.avatar.attached? %><%= image_tag @profile.avatar, alt: @profile.full_name %><% else %><img src="/images/juwon.jpg" alt="<%= @profile.full_name %>"><% end %>
      </div>
    </div>
  </div>
</section>

<section class="pb-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <div class="lg:col-span-7">
      <div class="card p-6" data-reveal="up">
        <h3 class="font-semibold text-ink">The longer story</h3>
        <div class="mt-3 text-sm text-ink-2 leading-relaxed space-y-3">
          <% if @profile.about_rich.present? %>
            <div class="prose-glass !text-sm"><%= @profile.about_rich %></div>
          <% elsif @profile.about.present? %>
            <% @profile.about.gsub("\r", "").split(/\n{2,}/).map(&:strip).reject(&:blank?).each do |block| %>
              <% lines = block.split("\n").map(&:strip).reject(&:blank?) %>
              <% if lines.size > 1 && lines.first.length < 70 && !lines.first.end_with?(".") %>
                <p class="font-medium text-ink pt-2"><%= lines.first %></p><p><%= lines[1..].join(" ") %></p>
              <% elsif block.length < 70 && !block.end_with?(".") %>
                <p class="font-medium text-ink pt-2"><%= block %></p>
              <% else %>
                <p><%= lines.join(" ") %></p>
              <% end %>
            <% end %>
          <% else %>
            <p><%= @profile.bio %></p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="lg:col-span-5 space-y-4">
      <% if @skills.any? %>
        <div class="card p-6" data-reveal="right" data-reveal-delay="0.05">
          <h3 class="font-semibold text-ink">Toolkit</h3>
          <div class="mt-4 grid grid-cols-4 gap-2">
            <% @skills.values.flatten.select { |sk| tech_icon(sk.name) }.first(12).each do |sk| %>
              <div class="tech-tile !p-3 !gap-1.5"><%= tech_icon(sk.name, css: "w-5 h-5") %><span class="!text-[10px] text-center leading-tight"><%= sk.name.sub(" (Turbo + Stimulus)", "").sub("/ES6+", "") %></span></div>
            <% end %>
          </div>
          <dl class="mt-4 space-y-2 text-xs">
            <% @skills.each do |category, skills| %>
              <div><dt class="text-ink-3"><%= category || "Other" %></dt><dd class="text-ink-2"><%= skills.map(&:name).join(", ") %></dd></div>
            <% end %>
          </dl>
        </div>
      <% end %>
      <% if @educations.any? %>
        <div class="card p-6" data-reveal="right" data-reveal-delay="0.1">
          <h3 class="font-semibold text-ink">Education</h3>
          <% @educations.each do |edu| %>
            <p class="mt-2 text-sm text-ink"><%= edu.institution %></p>
            <p class="text-xs text-ink-2"><%= [edu.degree, edu.field_of_study].compact_blank.join(" in ") %><% if edu.start_date.present? %> · <%= edu.start_date.strftime("%Y") %><%= "–#{edu.end_date.strftime('%Y')}" if edu.end_date.present? %><% end %></p>
          <% end %>
          <% if @profile.resume_pdf.attached? %><%= link_to "Download résumé →", rails_blob_path(@profile.resume_pdf, disposition: :attachment), class: "mt-4 inline-block text-sm text-ink hover:underline underline-offset-4" %><% end %>
        </div>
      <% end %>

    </div>
  </div>
</section>
