<% content_for :head do %>
  <%= json_ld_tag({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": @profile.full_name,
    "jobTitle": @profile.headline,
    "description": @profile.bio,
    "url": root_url,
    "sameAs": [@profile.github_url, @profile.linkedin_url, @profile.twitter_url].compact_blank,
    "address": { "@type": "PostalAddress", "addressCountry": @profile.location }
  }) %>
<% end %>

<%# ───────── HERO ───────── %>
<section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20" data-controller="hero parallax">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-6">
        <p class="eyebrow" data-hero="0" data-hero-kind="fade">Hi, I'm</p>
        <h1 class="display text-6xl sm:text-7xl lg:text-[5.5rem] mt-5" data-hero="1" data-hero-kind="words">
          <span class="text-hero"><%= @profile.last_name %></span><br><span class="text-hero-2"><%= @profile.first_name %>.</span>
        </h1>
        <p class="mt-7 text-lg sm:text-xl font-medium text-ink-2" data-hero="2"><%= @profile.headline %></p>
        <p class="mt-5 max-w-md text-[15px] text-ink-2 leading-relaxed" data-hero="2.5"><%= @profile.bio %></p>
        <div class="mt-9 flex flex-wrap items-center gap-3" data-hero="3">
          <%= link_to projects_path, class: "btn btn-primary", data: { controller: "magnetic", magnetic_strength_value: 0.2 } do %>View My Work <span aria-hidden="true">→</span><% end %>
          <%= link_to contact_path, class: "btn btn-glass", data: { controller: "magnetic", magnetic_strength_value: 0.2 } do %><span class="live-dot"></span> Let's Talk<% end %>
        </div>
        <div class="mt-9 flex items-center gap-5 text-ink-2" data-hero="4" data-hero-kind="fade">
          <% if @profile.github_url.present? %><a href="<%= @profile.github_url %>" target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-ink transition-colors"><svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg></a><% end %>
          <% if @profile.linkedin_url.present? %><a href="<%= @profile.linkedin_url %>" target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-ink transition-colors"><svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 110-4.13 2.06 2.06 0 010 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a><% end %>
          <% if @profile.twitter_url.present? %><a href="<%= @profile.twitter_url %>" target="_blank" rel="noopener" aria-label="X" class="hover:text-ink transition-colors"><svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/></svg></a><% end %>
          <% if @profile.email.present? %><a href="mailto:<%= @profile.email %>" aria-label="Email" class="hover:text-ink transition-colors"><svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></a><% end %>
          <% if @profile.available_for_hire? %><span class="ml-2 inline-flex items-center gap-2 text-xs text-ink-2"><span class="live-dot"></span>Available for new opportunities</span><% end %>
        </div>
      </div>

      <div class="lg:col-span-6 relative" data-hero="1.5" data-hero-kind="scale">
        <div class="relative mx-auto w-full max-w-[330px] sm:max-w-[380px]">
          <div class="portrait-panel aspect-[4/5]" data-controller="card-tilt" data-card-tilt-max-tilt-value="4" data-card-tilt-scale-value="1.01">
            <span class="glow" aria-hidden="true"></span>
            <% cutout = Rails.root.join("public/images/juwon-cutout.png").exist? %>
            <% if cutout %>
              <img src="/images/juwon-cutout.png" alt="<%= @profile.full_name %>" loading="eager" class="cutout">
            <% elsif @profile.avatar.attached? %>
              <%= image_tag @profile.avatar, alt: @profile.full_name, loading: "eager" %>
            <% else %>
              <img src="/images/juwon.jpg" alt="<%= @profile.full_name %>" loading="eager">
            <% end %>
          </div>
          <div class="absolute -right-6 sm:-right-14 bottom-[36%] z-10 glass glass-solid glass-sm px-4 py-3 min-w-[9.5rem]" data-parallax-speed="-0.08">
            <div class="flex items-center gap-2"><span class="live-dot"></span><span class="display text-2xl text-ink"><%= @stats[:years] %>+</span></div>
            <p class="mt-0.5 text-[11px] text-ink-2">Years Experience</p>
          </div>
        </div>
      </div>
    </div>

    <dl class="mt-16 sm:mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-line pt-10" data-hero="5" data-hero-kind="fade">
      <% [[@stats[:years], "+", "Years Experience"], [@posts_count, "", "Articles Written"], [@clients_count, "+", "Satisfied Clients"], [@stats[:projects], "+", "Projects Built"]].each do |v, suf, label| %>
        <div data-controller="animate-counter" data-animate-counter-target-value="<%= v.to_i %>" data-animate-counter-suffix-value="<%= suf %>">
          <dd class="display text-3xl sm:text-4xl text-ink" data-animate-counter-target="number">0</dd>
          <dt class="mt-1.5 text-xs text-ink-2"><%= label %></dt>
        </div>
      <% end %>
    </dl>
  </div>
</section>

<%# ───────── SELECTED PROJECTS ───────── %>
<% if @flagship.any? %>
<section class="py-14 sm:py-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <p class="eyebrow" data-reveal="fade">Featured work</p>
        <h2 class="display-serif text-4xl sm:text-5xl mt-3" data-reveal="up">Selected Projects</h2>
      </div>
      <%= link_to projects_path, class: "text-sm text-ink-2 hover:text-ink", data: { reveal: "fade" } do %>View all projects <span aria-hidden="true">→</span><% end %>
    </div>

    <% lead, *rest = @flagship.first(3) %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      <%= link_to project_path(lead), class: "lg:col-span-2 card card-lift p-7 sm:p-9 grid grid-cols-1 sm:grid-cols-2 gap-6 items-center min-h-[23rem] group", data: { reveal: "left" } do %>
        <div>
          <p class="text-xs text-ink-3"><%= lead.category.presence || lead.type_label %></p>
          <h3 class="mt-1.5 text-2xl font-semibold tracking-tight text-ink"><%= lead.title %></h3>
          <p class="mt-3 text-sm text-ink-2 leading-relaxed line-clamp-3"><%= lead.tagline.presence || lead.summary %></p>
          <span class="btn btn-glass btn-sm mt-6">View Project <span aria-hidden="true">→</span></span>
          <% if lead.tech_stack.any? %>
            <div class="mt-6 flex flex-wrap gap-1.5"><% lead.tech_stack.first(4).each do |t| %><span class="chip"><%= t %></span><% end %></div>
          <% end %>
        </div>
        <div class="tilt-3d sm:-mr-16 sm:-my-10">
          <div class="shot aspect-[16/10]">
            <% if lead.cover_image.attached? %><%= image_tag lead.cover_image, alt: lead.title, loading: "eager" %><% end %>
          </div>
        </div>
        <span class="glow-blob -left-20 -bottom-24 opacity-70"></span>
      <% end %>

      <div class="grid grid-rows-2 gap-5">
        <% rest.each_with_index do |pr, i| %>
          <%= link_to project_path(pr), class: "card card-lift p-6 flex items-center gap-4 group", data: { reveal: "right", reveal_delay: 0.1 * (i + 1) } do %>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-ink-3"><%= pr.category.presence || pr.type_label %></p>
              <h3 class="mt-1.5 font-semibold tracking-tight text-ink flex items-center gap-1.5"><%= pr.title %> <span class="text-ink-3 group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span></h3>
            </div>
            <div class="w-[46%] shrink-0 shot aspect-[16/10] -mr-10 translate-y-3 rotate-[-2deg] group-hover:rotate-0 transition-transform duration-500">
              <% if pr.cover_image.attached? %><%= image_tag pr.cover_image, alt: pr.title, loading: "lazy" %><% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# ───────── TRUSTED BY ───────── %>
<% if @clients.any? %>
<section class="py-8" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 text-center">
    <p class="text-sm text-ink-2" data-reveal="fade">Trusted by individuals and businesses worldwide</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4" data-reveal="stagger">
      <% @clients.first(7).each do |name| %><span class="text-base sm:text-lg font-semibold tracking-tight text-ink-3"><%= name %></span><% end %>
    </div>
  </div>
</section>
<% end %>

<%# ───────── TECHNOLOGIES ───────── %>
<% tiles = Skill.ordered.to_a.select { |s| tech_icon(s.name) }.first(14) %>
<% if tiles.any? %>
<section class="py-14 sm:py-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <p class="eyebrow" data-reveal="fade">Expertise</p>
        <h2 class="display-serif text-4xl sm:text-5xl mt-3" data-reveal="up">Technologies I work with</h2>
      </div>
      <%= link_to about_path, class: "text-sm text-ink-2 hover:text-ink", data: { reveal: "fade" } do %>View all skills <span aria-hidden="true">→</span><% end %>
    </div>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-4" data-reveal="stagger">
      <% tiles.each do |skill| %>
        <div class="tech-tile"><%= tech_icon(skill.name) %><span><%= skill.name.sub(" (Turbo + Stimulus)", "").sub("/ES6+", "") %></span></div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# ───────── JOURNEY ───────── %>
<% if @experiences.any? %>
<section class="py-14 sm:py-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-10">
      <div>
        <p class="eyebrow" data-reveal="fade">Experience</p>
        <h2 class="display-serif text-4xl sm:text-5xl mt-3" data-reveal="up">My Professional Journey</h2>
      </div>
      <%= link_to experience_path, class: "text-sm text-ink-2 hover:text-ink", data: { reveal: "fade" } do %>View full timeline <span aria-hidden="true">→</span><% end %>
    </div>
    <ol class="hline grid grid-cols-1 sm:grid-cols-3 gap-8 pt-7" data-reveal="stagger">
      <% @experiences.each do |exp| %>
        <li class="relative pl-5">
          <span class="hline-dot -top-7"></span>
          <p class="text-xs text-ink-3"><%= exp.start_date.strftime("%Y") %> – <%= exp.current? ? "Present" : exp.end_date&.strftime("%Y") %></p>
          <p class="mt-1.5 font-semibold text-ink"><%= exp.role %></p>
          <p class="text-sm text-ink-2"><%= exp.company %><% if exp.location.present? %> · <%= exp.location %><% end %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>
<% end %>

<%# ───────── CTA ───────── %>
<section class="py-14 sm:py-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="card p-8 sm:p-12 flex flex-col md:flex-row md:items-center justify-between gap-8" data-reveal="scale">
      <div class="max-w-xl">
        <p class="eyebrow">Let's build something great</p>
        <h2 class="display-serif text-4xl sm:text-5xl mt-3">Have a project in mind?</h2>
        <p class="mt-4 text-[15px] text-ink-2 leading-relaxed">I'm always open to discussing new projects, creative ideas, or opportunities to be part of something meaningful.</p>
      </div>
      <%= link_to contact_path, class: "btn btn-primary btn-lg shrink-0", data: { controller: "magnetic" } do %>Let's Work Together <span aria-hidden="true">→</span><% end %>
      <span class="glow-blob -right-24 -bottom-28"></span>
    </div>
  </div>
</section>

<% if @posts.any? %>
<section class="py-14 sm:py-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <p class="eyebrow" data-reveal="fade">Blog</p>
        <h2 class="display-serif text-4xl sm:text-5xl mt-3" data-reveal="up">Insights & Ideas</h2>
      </div>
      <%= link_to blog_path, class: "text-sm text-ink-2 hover:text-ink", data: { reveal: "fade" } do %>View all articles <span aria-hidden="true">→</span><% end %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5" data-reveal="stagger">
      <% @posts.each do |post| %><%= render "components/blog_card", post: post %><% end %>
    </div>
  </div>
</section>
<% end %>
