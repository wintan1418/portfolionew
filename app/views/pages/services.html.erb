<% content_for :head do %>
  <%= json_ld_tag({ "@context": "https://schema.org", "@type": "Service", "provider": { "@type": "Person", "name": @profile.full_name, "jobTitle": @profile.headline }, "serviceType": "Software Development", "areaServed": "Worldwide" }) %>
<% end %>

<section class="pt-32 pb-10 sm:pt-40" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <h1 class="display-serif text-5xl sm:text-6xl" data-reveal="up">Services.</h1>
    <p class="mt-5 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">I help individuals and businesses turn ideas into high-quality digital products.</p>
  </div>
</section>

<section class="pb-6" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-4" data-reveal="stagger">
    <% [
      ["Web Application Development", "Custom web applications using Ruby on Rails, Hotwire, React and modern technologies. Auth, billing, admin and deployment included.", "M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 4h16", "build"],
      ["SaaS Architecture", "Scalable, multi-tenant SaaS products with clean architecture, PostgreSQL design and best practices from day one.", "M4 7h16M4 12h16M4 17h10", "build"],
      ["Rebuilds and Migrations", "Agency builds, WordPress sites and legacy apps rebuilt on Rails with the data and search rankings carried over.", "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15", "rebuild"],
      ["AI Integration", "Add assistants, document search with pgvector and automation to your product. Metered, rate-limited and logged.", "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z", "ai layer"],
      ["Catalogs, Portals and Quote Flows", "Searchable product data, customer and staff portals, compare and quote tools for businesses that sell by conversation.", "M3 7h18M3 12h18M3 17h18", "build"],
      ["Consulting", "Technical advisory, code reviews and architectural guidance for your team or project.", "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z", "consulting"]
    ].each do |title, body, icon, topic| %>
      <%= link_to contact_path(topic: topic), class: "card card-lift p-6 flex gap-5 items-start group" do %>
        <span class="icon-tile shrink-0"><svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg></span>
        <span class="flex-1 min-w-0">
          <span class="block font-semibold text-ink"><%= title %></span>
          <span class="block mt-1.5 text-sm text-ink-2 leading-relaxed"><%= body %></span>
        </span>
        <span class="text-ink-3 group-hover:text-ink group-hover:translate-x-0.5 transition-all pt-1" aria-hidden="true">→</span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="py-10" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal="stagger">
      <% [["01", "Discovery call", "Thirty minutes on what you are building, who it is for and what already exists. Free."], ["02", "Written plan", "Scope, schema sketch, milestones and a fixed price or weekly rate."], ["03", "Build in the open", "A staging URL from week one. Tests and CI from the first commit."], ["04", "Launch and stay", "Deploy, monitoring, backups and a handover doc. I stay on for the next phase if you want."]].each do |n, title, body| %>
        <div class="card p-5"><p class="text-xs text-ink-3"><%= n %></p><h3 class="mt-1 font-semibold text-ink"><%= title %></h3><p class="mt-2 text-sm text-ink-2 leading-relaxed"><%= body %></p></div>
      <% end %>
    </div>
  </div>
</section>

<% if @examples.any? %>
<section class="py-6" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-6"><div><p class="eyebrow" data-reveal="fade">Proof</p><h2 class="section-title mt-2" data-reveal="up">Recent builds</h2></div><%= link_to "All projects →", projects_path, class: "text-sm text-ink-2 hover:text-ink" %></div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" data-reveal="stagger"><% @examples.each do |project| %><%= render "components/project_card", project: project %><% end %></div>
  </div>
</section>
<% end %>

<section class="py-10" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="card p-8 sm:p-10 text-center" data-reveal="scale">
      <h2 class="display-serif text-4xl sm:text-5xl">Have a project in mind?</h2>
      <p class="mt-3 max-w-lg mx-auto text-sm sm:text-[15px] text-ink-2 leading-relaxed">I'm open to discussing new projects, creative ideas, or opportunities to be part of something great.</p>
      <%= link_to contact_path, class: "btn btn-primary mt-6", data: { controller: "magnetic" } do %>Let's Work Together <span aria-hidden="true">→</span><% end %>
      <span class="glow-blob -right-24 -bottom-28"></span>
    </div>
  </div>
</section>
