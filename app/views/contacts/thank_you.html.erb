<section class="pt-32 pb-24 sm:pt-52" data-controller="reveal">
  <div class="max-w-2xl mx-auto px-5 sm:px-6 card p-10" data-reveal="scale">
    <h1 class="display text-4xl sm:text-5xl" data-reveal="up">Thanks, talk soon.</h1>
    <p class="mt-5 text-lg text-ink-2 max-w-xl" data-reveal="up" data-reveal-delay="0.05">Your message is in my inbox. I reply within one working day, usually faster.</p>
    <div class="mt-8 flex gap-3" data-reveal="fade" data-reveal-delay="0.1">
      <%= link_to "See the work", projects_path, class: "btn btn-primary" %>
      <%= link_to "Back home", root_path, class: "btn btn-glass" %>
    </div>
  </div>
</section>
