<section class="pt-32 pb-10 sm:pt-40" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <h1 class="display-serif text-5xl sm:text-6xl" data-reveal="up">Let's Work Together</h1>
    <p class="mt-5 max-w-xl text-[15px] sm:text-base text-ink-2 leading-relaxed" data-reveal="up" data-reveal-delay="0.05">I'm open to discussing new projects, creative ideas, or opportunities to be part of something great.</p>
  </div>
</section>

<section class="pb-20" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <div class="lg:col-span-7 card p-6 sm:p-8" data-reveal="up">
      <%= form_with(model: @contact, url: contact_path, class: "space-y-4") do |f| %>
        <% if @contact.errors.any? %>
          <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-300 light:text-rose-700 px-4 py-3 text-sm"><ul class="list-disc list-inside space-y-1"><% @contact.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
        <% end %>
        <div><%= f.label :name, class: "label" %><%= f.text_field :name, required: true, placeholder: "Your name", class: "field" %></div>
        <div><%= f.label :email, class: "label" %><%= f.email_field :email, required: true, placeholder: "your@email.com", class: "field" %></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :subject, "Project type", class: "label" %>
            <%= f.select :subject, options_for_select([["Select a project type", ""], ["New web application", "New web application"], ["Rebuild or migration", "Rebuild or migration"], ["SaaS product", "SaaS product"], ["AI integration", "AI integration"], ["Consulting", "Consulting"], ["Full-time role", "Full-time role"], ["Something else", "Something else"]], @contact.subject.presence || { "build" => "New web application", "rebuild" => "Rebuild or migration", "ai layer" => "AI integration", "consulting" => "Consulting" }[params[:topic].to_s]), {}, class: "field" %>
          </div>
          <div>
            <%= f.label :budget_range, "Budget", class: "label" %>
            <%= f.select :budget_range, options_for_select([["Not sure yet", "unsure"], ["Under $1,000", "< $1k"], ["$1,000 to $5,000", "$1k-$5k"], ["$5,000 to $10,000", "$5k-$10k"], ["$10,000 and up", "$10k+"]], @contact.budget_range), {}, class: "field" %>
          </div>
        </div>
        <div><%= f.label :message, class: "label" %><%= f.text_area :message, required: true, rows: 6, placeholder: "Tell me about your project...", class: "field resize-y" %></div>
        <%= f.button type: "submit", class: "btn btn-primary w-full sm:w-auto", data: { controller: "magnetic", magnetic_strength_value: 0.15 } do %>Send Message <span aria-hidden="true">→</span><% end %>
      <% end %>
    </div>

    <div class="lg:col-span-5 card p-6" data-reveal="right" data-reveal-delay="0.1">
      <h2 class="font-semibold text-ink">Other ways to reach me</h2>
      <ul class="mt-4 space-y-4">
        <% rows = [] %>
        <% rows << ["Email", @profile.email, "mailto:#{@profile.email}", "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"] if @profile.email.present? %>
        <% rows << ["Location", @profile.location, nil, "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"] if @profile.location.present? %>
        <% rows << ["LinkedIn", @profile.linkedin_url.sub(%r{https?://(www\.)?}, ""), @profile.linkedin_url, "M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 2a2 2 0 110 4 2 2 0 010-4z"] if @profile.linkedin_url.present? %>
        <% rows << ["GitHub", @profile.github_url.sub(%r{https?://(www\.)?}, ""), @profile.github_url, "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"] if @profile.github_url.present? %>
        <% whatsapp = SocialLink.visible.find_by(platform: "whatsapp") %>
        <% rows << ["WhatsApp", "Message me directly", whatsapp.url.strip, "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"] if whatsapp %>
        <% rows.each do |label, value, href, icon| %>
          <li class="flex items-center gap-4">
            <span class="icon-tile shrink-0"><svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg></span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-ink"><%= label %></p>
              <% if href %><a href="<%= href %>" <%= 'target="_blank" rel="noopener"'.html_safe unless href.start_with?("mailto:") %> class="text-xs text-ink-2 hover:text-ink break-all"><%= value %></a><% else %><p class="text-xs text-ink-2"><%= value %></p><% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @profile.available_for_hire? %><p class="mt-6 pt-5 border-t border-line text-xs text-ink-2 flex items-center gap-2"><span class="live-dot"></span><%= @profile.availability_text.presence || "Available for new opportunities" %></p><% end %>
    </div>
  </div>
</section>
