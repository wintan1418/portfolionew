<%# locals: (project:, size: :default) %>
<%= link_to project_path(project), class: "card card-lift p-5 flex flex-col group h-full" do %>
  <div class="shot aspect-[16/10] mb-5">
    <% if project.cover_image.attached? %>
      <%= image_tag project.cover_image, alt: project.title, loading: "lazy" %>
    <% else %>
      <div class="w-full h-full grid place-items-center text-ink-3 text-3xl font-semibold"><%= project.title.first(2).upcase %></div>
    <% end %>
  </div>
  <p class="text-xs text-ink-3"><%= project.category.presence || project.type_label %><% if project.year %> · <%= project.year %><% end %></p>
  <h3 class="mt-1 font-semibold tracking-tight text-ink flex items-center gap-1.5"><%= project.title %> <span class="text-ink-3 group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span></h3>
  <% if (text = project.tagline.presence || project.summary).present? %>
    <p class="mt-1.5 text-sm text-ink-2 line-clamp-2 leading-relaxed"><%= text %></p>
  <% end %>
  <% if project.tech_stack.any? %>
    <div class="mt-4 flex flex-wrap gap-1.5"><% project.tech_stack.first(4).each do |t| %><span class="chip"><%= t %></span><% end %></div>
  <% end %>
<% end %>
