<%= link_to blog_post_path(post.slug), data: { turbo_frame: "_top" }, class: "card card-lift p-5 flex flex-col group h-full" do %>
  <div class="shot aspect-[16/10] mb-5">
    <% if post.cover_image.attached? %>
      <%= image_tag post.cover_image, loading: "lazy" %>
    <% else %>
      <div class="w-full h-full grid place-items-center text-ink-3 text-3xl font-semibold"><%= post.title.first(2).upcase %></div>
    <% end %>
  </div>
  <p class="text-xs text-ink-3"><%= post.published_at&.strftime("%b %d, %Y") %><% if post.reading_time %> · <%= post.reading_time %> min<% end %><% if post.category %> · <%= post.category.name %><% end %></p>
  <h3 class="mt-1 font-semibold tracking-tight text-ink leading-snug line-clamp-2"><%= post.title %></h3>
  <% if post.excerpt.present? %><p class="mt-1.5 text-sm text-ink-2 line-clamp-2 leading-relaxed"><%= post.excerpt %></p><% end %>
<% end %>
